rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId}/familyEntries/{entryId} {
      allow read, list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(entryId) && request.resource.data.userId == userId;
      allow update: if isOwner(userId) && isValidId(entryId) && request.resource.data.userId == userId;
      allow delete: if isOwner(userId) && isValidId(entryId);
    }
  }
}
